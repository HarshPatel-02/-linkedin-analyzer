# LinkedIn AI Analyzer - every setting it reads (services/config.py). Copy to .env.
# Empty = the default shown. The Apify token is NOT set here: the extension sends it.

# ── Access ───────────────────────────────────────────────────────────────────
# Required once the server is reachable by others (always on Render). The extension
# sends it from its Development section (click the popup title 5 times).
ANALYZER_API_KEY=
# Requests per minute per client, once the server is public.
RATE_LIMIT_PER_MINUTE=60

# ── Apify actors ─────────────────────────────────────────────────────────────
# Profile actor (default harvestapi/linkedin-profile-scraper).
APIFY_ACTOR_ID=LpVuK3Zozwuipa5bp
# Posts actor (required for post-based Activity).
APIFY_POSTS_ACTOR_ID=
# Company details by company page (default harvestapi/linkedin-company).
APIFY_COMPANY_DETAILS_ACTOR_ID=UwSdACBp7ymaGUJjS
# Older profile-based actor: the fallback when a profile names no company page.
APIFY_COMPANY_ACTOR_ID=
# Seconds Apify lets one run take before stopping it (and its billing).
APIFY_RUN_TIMEOUT=75
# Posts read per profile.
MAX_POSTS=20

# ── AI (message wording only; scores never use AI) ───────────────────────────
# Groq is tried first, OpenRouter second. At least one key is needed for ✨ suggestions.
GROQ_API_KEY=
# Empty: the best chat model Groq offers is picked automatically.
GROQ_MODEL=
OPENROUTER_API_KEY=
# One model, or a comma-separated fallback list.
OPENROUTER_MODEL=openrouter/free
AI_TEMPERATURE=0.8
